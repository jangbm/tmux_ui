Screen { background: #171a19; color: #d4dbd6; }
#stage { height: 1fr; background: #171a19; layers: groups content grip overlay; }
.editor-group { position: absolute; layer: groups; background: #171a19; }
.group-header { height: 3; background: #202421; border-bottom: solid #30383e; }
.active-group .group-header { background: #222a31; }
.group-tabs { height: 3; width: 1fr; scrollbar-size: 1 1; }
.tab-chip { width: auto; height: 3; min-width: 10; max-width: 27; padding: 0; margin-right: 0; background: #1d2226; border: round #30383e; border-bottom: none; }
.tab-chip.selected { background: #171a19; border: round #7faecc; border-bottom: none; color: #e3edf4; }
.tab-label { width: auto; min-width: 5; max-width: 21; height: 1; padding: 0 1; color: #b0bcb3; }
.tab-chip.selected .tab-label { color: #d9eaf6; text-style: none; }
.tab-chip:hover { background: #29323a; }
.close-tab { width: 3; min-width: 3; height: 1; padding: 0; border: none; background: transparent; color: #7e8c82; }
.close-tab:hover { background: #39433c; color: #f1f4f2; }
.group-header > Button { width: 3; min-width: 3; height: 3; padding: 0; border: none; background: transparent; color: #9aada0; }
.group-header > Button:hover { background: #374039; color: #e4eee7; }
.group-body { height: 1fr; }
.project-view { position: absolute; layer: content; background: #171a19; }
.project-view.stacked { layout: vertical; }
.chat-panel { width: 1fr; height: 1fr; padding: 0 1; background: #171a19; }
.chat-heading { height: 2; padding: 0 1; align-vertical: middle; }
.agent-name { width: auto; height: 1; margin-right: 2; color: #c3d1c7; text-style: bold; }
.chat-status { width: 1fr; height: 1; color: #718178; }
.close-chat { width: 3; min-width: 3; height: 1; padding: 0; border: none; background: transparent; color: #8a9a8f; }
.close-chat:hover { color: #f1d6cd; background: #3d302d; }
.thread { height: 1fr; padding: 0 1; scrollbar-size: 1 1; background: #171a19; }
.source-message { height: auto; color: #9ca9a0; margin-bottom: 1; }
.messages { height: auto; color: #d4dbd6; align-horizontal: right; }
.message-card { height: auto; margin: 0; }
.message-role { height: 1; margin-bottom: 0; color: #9eb3a5; text-style: bold; }
.message-body { height: auto; color: #dce3de; background: transparent; }
Markdown { padding: 0; margin: 0; background: transparent; }
MarkdownFence { background: #202923; }
.user-message { width: 90%; max-width: 90%; margin-left: 2; padding: 0 1; border: none; border-left: solid #618372; background: #26332b; }
.user-message .message-role { display: none; }
.pending-reply { height: auto; margin-bottom: 0; }
.chat-error { height: auto; color: #daa99a; margin: 1 0; }
.welcome-title { height: 2; text-style: bold; color: #d7e6db; }
.welcome-note { height: auto; color: #8da193; }
.composer-box { height: 4; margin: 0; padding: 0; background: #20272d; border: round #3e4b56; }
.composer-box:focus-within { border: round #7faecc; }
.composer { width: 1fr; height: 2; padding: 0 1; border: none; background: #20272d; color: #edf1ed; }
.composer-actions { width: 3; height: 2; padding: 0; margin-right: 1; }
.send, .stop { width: 3; min-width: 3; height: 1; border: none; padding: 0; text-style: none; }
.send { color: #17231b; background: #8ab4d2; margin-bottom: 0; }
.send:hover { background: #b7d3e7; }
.stop { color: #b5c1b8; background: #303a32; }
.stop:hover { background: #493833; color: #e6b9a8; }
.send:disabled, .stop:disabled { color: #59665d; background: #273029; }
.composer-hint { height: 1; padding: 0 1; margin-bottom: 0; color: #6d7c88; }
.compact-chat .composer-box { height: 3; margin-top: 0; }
.compact-chat .composer { height: 1; }
.compact-chat .composer-actions { height: 1; layout: horizontal; width: 6; }
.compact-chat .send { margin-bottom: 0; }
.compact-chat .composer-hint { display: none; }
.agent-grip { width: 1; height: 1fr; background: #343e36; }
.agent-grip:hover { background: #829a89; }
.stacked .agent-grip { width: 1fr; height: 1; }
#group-grip { position: absolute; layer: grip; background: #46514a; }
#group-grip:hover { background: #a1b9a7; }
#drop-preview { position: absolute; layer: overlay; display: none; background: #8ca897 20%; border: solid #94b69f; }
.empty-project { width: 1fr; height: 1fr; align: center middle; }
.empty-symbol { height: 3; width: 1fr; text-align: center; color: #779581; }
.empty-title { height: 2; width: 1fr; text-align: center; color: #c6d3ca; text-style: bold; }
.empty-note { height: 2; width: 1fr; text-align: center; color: #7c9083; }
.restore-buttons { width: auto; height: 3; align-horizontal: center; }
.restore-chat { min-width: 10; width: auto; height: 3; margin-right: 1; border: round #53675a; background: #26332a; color: #c0d4c6; }

.source-target { height: 3; margin: 0; }
.mode-toggle { width: 5; min-width: 5; height: 1; border: none; padding: 0; background: transparent; color: #d9a07e; }
.mode-toggle:hover { background: #3b3430; }

.menu-controls { display: none; height: 1; padding: 0 1; }
.menu-key { height: 1; width: 5; min-width: 5; padding: 0; border: none; margin-right: 1; background: #2b3944; color: #aacbe1; }
.menu-key:hover { background: #3e5669; }
.shutdown-ai { width: 3; min-width: 3; height: 1; padding: 0; border: none; background: transparent; color: #b78c7d; }
.shutdown-ai:hover { color: #f0a28e; background: #3d302d; }
/* Neutral workbench; color is reserved for focus, AI status and results. */
Screen, #stage, .editor-group, .project-view, .chat-panel, .thread { background: #1b1d20; color: #d8dce2; }
.group-header { background: #22252a; border-bottom: solid #383d45; }
.active-group .group-header { background: #252a31; }
.tab-chip { background: #22252a; border: round #3b414a; border-bottom: none; }
.tab-chip.selected { background: #1b1d20; border: round #78a9d1; border-bottom: none; }
.tab-label, .source-message { color: #b9c0ca; }
.composer-box, .composer { background: #25292f; }
.thread-search { height: 3; border: round #4a6077; padding: 0 1; }
.jump-latest { height: 1; width: auto; min-width: 14; border: none; padding: 0 1; background: #2e3b4a; color: #b9d6ef; }
.queue-bar { height: 1; margin: 0 1; background: #252d36; }
.queue-summary { width: 1fr; height: 1; color: #afc5da; }
.queue-bar Button { height: 1; width: 5; min-width: 3; padding: 0; border: none; background: #344151; }
.source-busy .composer-hint { color: #9cbfdf; }
.source-waiting .composer-hint { color: #e6a295; }
.single-line .composer-actions { width: 6; height: 1; layout: horizontal; }
.single-line .send { margin-bottom: 0; }
.copy-selection { width: 3; min-width: 3; height: 1; border: none; padding: 0; background: transparent; color: #a2b3c5; }

/* Design audit: readable secondary text and consistent workbench states. */
.tab-chip { min-width: 9; max-width: 25; margin-right: 1; }
.tab-label { min-width: 4; max-width: 19; }
.tab-chip.selected { border: round #91bfe5; border-bottom: none; }
.tab-chip.selected .tab-label { color: #f0f4fa; text-style: bold; }
.tab-chip.pinned { background: #2c3440; }
.tab-chip.pinned.selected { background: #1b1d20; }
.tab-chip.dragging { background: #354f68; border: round #b8dcfa; border-bottom: none; }
.narrow-group .split-right, .narrow-group .split-below { display: none; }
.chat-status, .composer-hint { color: #acb6c4; }
.chat-heading { padding: 0; }
.agent-name { margin-right: 1; }
.agent-name.claude { color: #e9b39a; }
.agent-name.codex { color: #a9cce9; }
.source-busy .chat-status { color: #a9cce9; }
.source-waiting .chat-status { color: #f0b39e; }
.narrow-chat .chat-heading { align-vertical: top; }
.narrow-chat .chat-status { position: absolute; offset: 0 1; width: 1fr; }
.narrow-chat .agent-name { width: 1fr; }
.narrow-chat .composer-hint { display: none; }
.menu-controls { padding: 0; background: #2d3540; }
.menu-key { width: 1fr; min-width: 3; margin-right: 0; color: #d4e6f5; }
.queue-bar { margin: 0; }
.queue-bar Button { width: 4; color: #d4e6f5; }
.queue-bar .queue-cancel, .queue-bar .queue-toggle { width: 3; }
.agent-grip, #group-grip { background: #3b4653; }
.agent-grip:hover, #group-grip:hover { background: #91bfe5; }
#drop-preview { background: #78a9d1 20%; border: solid #91bfe5; }
.empty-note { height: auto; max-width: 60; padding: 0 2; color: #acb6c4; }
.chat-error { color: #f0b39e; margin: 0; }
.close-chat, .close-tab, .copy-selection { color: #acb6c4; }
Button:focus { text-style: bold; tint: #91bfe5 12%; }

.mode-toggle { width: 6; min-width: 6; }

.queue-bar .queue-edit { width: 6; }

/* Native terminal caret is positioned by Desktop for IME composition. */
.composer > .text-area--cursor { background: transparent; color: #edf1ed; text-style: none; }
